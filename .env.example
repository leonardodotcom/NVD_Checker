# NVD Checker settings. Copy to `.env` in the project folder; the app loads it
# automatically at startup. Real environment variables override these values.

# ---- Required ---------------------------------------------------------------
# Signs the login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ---- NVD --------------------------------------------------------------------
# Optional but recommended: raises NVD rate limit from 5 to 50 requests / 30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Seconds to cache identical NVD queries
CACHE_TTL=900

# ---- Storage ----------------------------------------------------------------
# SQLite file holding users, projects and keywords (the Docker setup overrides this to /data/...)
DB_PATH=nvd_checker.db

# ---- Web / security ---------------------------------------------------------
# 1 = session cookie only sent over HTTPS. Keep 1 in production; set 0 only for local http testing.
COOKIE_SECURE=1
# Login session lifetime in seconds (default 8 hours)
SESSION_MAX_AGE=28800
# 1 = expose interactive API docs at /docs (off by default)
ENABLE_DOCS=0

# ---- Chinese databases (CNNVD / CNVD) ---------------------------------------
# Folder holding the saved login sessions (credentials! keep it private; Docker uses /data/sessions).
CN_SESSION_DIR=sessions
# Seconds to wait between page requests to the Chinese sites (be polite)
CN_REQUEST_DELAY=1.5
# Safety cap on pages fetched per search window
CN_MAX_PAGES=40
# Seconds to reuse a fetched window (default 6 hours)
CN_CACHE_TTL=21600

# ---- Reverse proxy (Docker setup only) --------------------------------------
# Hostname users type in the browser
SITE_ADDRESS=nvd-checker.example.local
# "internal" = Caddy generates its own certificate (browsers will warn until its root CA is trusted).
# To use a certificate from your IT team, put the files in ./certs and set:
#   CADDY_TLS=/certs/cert.pem /certs/key.pem
CADDY_TLS=internal

# ---- Corporate outbound proxy (only if your network requires one) ----------
# HTTPS_PROXY=http://proxy.yourcompany.local:8080
# NO_PROXY=localhost,127.0.0.1
# If the proxy inspects TLS, point to your company's root CA bundle:
# SSL_CERT_FILE=/certs/company-ca.pem
